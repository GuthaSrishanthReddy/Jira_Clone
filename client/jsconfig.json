// This config allows VSCode intellisense to work with absolute "src" imports and jsx files
{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react",
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "cypress/**/*.js", "./node_modules/cypress"]
}
